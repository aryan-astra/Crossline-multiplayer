{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".server-build",
    "rootDir": "."
  },
  "include": [
    "server.ts",
    "src/server/**/*.ts",
    "src/network/**/*.ts",
    "src/game/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

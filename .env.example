# Optional custom server settings; defaults work without an environment file.
# Set these in your shell before npm run dev/start. The server does not load .env itself.
# PORT=3000
# HOST=127.0.0.1
# DATA_FILE=data/crossline.sqlite
# PUBLIC_ORIGIN=https://your-game.example
# Set PUBLIC_ORIGIN behind a TLS proxy. Render's RENDER_EXTERNAL_URL is used automatically.
# Never put private credentials in NEXT_PUBLIC_* variables.

{
  "name": "crossline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "npm run build:server && node .server-build/server.js --dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && next build",
    "start": "node .server-build/server.js",
    "start:lan": "node scripts/start-lan.mjs",
    "lint": "eslint src tests server.ts",
    "format": "prettier --write src tests docs README.md package.json tsconfig*.json *.mjs next.config.ts server.ts .github",
    "format:check": "prettier --check src tests docs README.md package.json tsconfig*.json *.mjs next.config.ts server.ts .github",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "benchmark": "tsc -p tsconfig.test.json && node .test-build/tests/benchmark.js",
    "endurance": "tsc -p tsconfig.test.json && node --expose-gc .test-build/tests/endurance.js",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
